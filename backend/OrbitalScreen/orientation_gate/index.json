{
  "schema_version": "1.0.0",
  "timestamp": "2025-01-23T16:20:00Z",
  "mission": "Scaffold Cockpit Launch Protocol",
  "commander": "Orbital",
  "description": "Machine-readable schema for Evidence Pack validation and verification",
  "evidence_pack_schema": {
    "type": "object",
    "required": [
      "agent_id",
      "agent_name",
      "mission_id",
      "timestamp",
      "evidence_entries"
    ],
    "properties": {
      "agent_id": {
        "type": "string",
        "pattern": "^agent_[a-z0-9_]+$",
        "description": "Unique identifier for the agent"
      },
      "agent_name": {
        "type": "string",
        "description": "Human-readable name of the agent"
      },
      "mission_id": {
        "type": "string",
        "description": "Identifier for the current mission"
      },
      "timestamp": {
        "type": "string",
        "format": "date-time",
        "description": "ISO 8601 timestamp in UTC"
      },
      "evidence_entries": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": [
            "entry_id",
            "entry_type",
            "timestamp",
            "description",
            "verification_hash"
          ],
          "properties": {
            "entry_id": {
              "type": "string",
              "description": "Unique identifier for this evidence entry"
            },
            "entry_type": {
              "type": "string",
              "enum": [
                "action_log",
                "decision_record",
                "communication_record",
                "task_documentation",
                "error_report",
                "checkpoint",
                "handoff_material"
              ],
              "description": "Type of evidence entry"
            },
            "timestamp": {
              "type": "string",
              "format": "date-time",
              "description": "When this evidence was created"
            },
            "description": {
              "type": "string",
              "description": "Human-readable description of the evidence"
            },
            "content": {
              "type": "object",
              "description": "Structured content of the evidence"
            },
            "verification_hash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$",
              "description": "SHA256 hash for integrity verification"
            },
            "severity": {
              "type": "string",
              "enum": ["info", "warning", "error", "critical"],
              "description": "Severity level of the evidence"
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Tags for categorization"
            }
          }
        }
      },
      "metadata": {
        "type": "object",
        "properties": {
          "clearance_level": {
            "type": "string",
            "description": "Agent's clearance level"
          },
          "mission_phase": {
            "type": "string",
            "description": "Current phase of the mission"
          },
          "predecessor_agent": {
            "type": "string",
            "description": "ID of predecessor agent if applicable"
          },
          "successor_agent": {
            "type": "string",
            "description": "ID of successor agent if applicable"
          }
        }
      },
      "verification": {
        "type": "object",
        "required": ["pack_hash", "entry_count"],
        "properties": {
          "pack_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "description": "SHA256 hash of entire evidence pack"
          },
          "entry_count": {
            "type": "integer",
            "minimum": 1,
            "description": "Total number of evidence entries"
          },
          "verified_by": {
            "type": "string",
            "description": "Agent or system that verified this pack"
          },
          "verification_timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "When verification was performed"
          }
        }
      }
    }
  },
  "validation_rules": {
    "checksum_algorithm": "SHA256",
    "timestamp_format": "ISO 8601 UTC",
    "required_evidence_types": [
      "action_log",
      "decision_record"
    ],
    "minimum_entries": 1,
    "maximum_age_days": 365
  },
  "integration_points": {
    "doctrinal_verification_log": {
      "module": "backend/OrbitalScreen/launch_protocol/doctrinal_verification_log.py",
      "purpose": "Logs evidence pack creation and verification events"
    },
    "comm_bridge": {
      "module": "backend/OrbitalScreen/launch_protocol/comm_bridge.py",
      "purpose": "Transmits evidence pack references in handoff messages"
    },
    "credential_map": {
      "module": "backend/OrbitalScreen/launch_protocol/credential_map.yaml",
      "purpose": "Enforces access control for evidence pack viewing"
    }
  }
}
